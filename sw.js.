const cacheName = 'smart-kids-v1';
const assets = [
  '/',
  '/index.html',
  '/manifest.json',
  '/icon-192.png.jpg',
  '/icon-512.png.jpg'
];

// تخزين ملفات التطبيق في ذاكرة الهاتف عند التثبيت
self.addEventListener('install', e => {
  e.waitUntil(
    caches.open(cacheName).then(cache => {
      cache.addAll(assets);
    })
  );
});

// جلب الملفات من الذاكرة ليعمل التطبيق بسرعة وبدون إنترنت
self.addEventListener('fetch', e => {
  e.respondWith(
    caches.match(e.request).then(res => {
      return res || fetch(e.request);
    })
  );
});
